APP_NAME=SocialScope
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# Instagram Story provider (StoriesFly API v1). Server-side only; never expose.
# Leave empty in this example. The real key belongs only in local .env (ignored by Git).
STORIESFLY_API_KEY=
STORIESFLY_ENABLED=true
STORIESFLY_DAILY_UNIT_CAP=40

# TikTok Story provider (TikWM). No key required.
TIKWM_ENABLED=true

# In-memory Story cache TTL in seconds.
STORY_CACHE_TTL=45

# Abuse limits per client IP and globally, per minute.
RATE_LIMIT_PER_IP_PER_MINUTE=12
RATE_LIMIT_GLOBAL_PER_MINUTE=90
